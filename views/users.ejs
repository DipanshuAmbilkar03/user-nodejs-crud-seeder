<%- include("partials/header", { title: "Users" }) %>

<div class="page-header">
  <div>
    <h1>All users</h1>
    <p class="muted">Browse and manage every user in the database.</p>
  </div>
  <a class="btn btn-primary" href="/user/new">Add user</a>
</div>

<% if (notice) { %>
  <div class="alert alert-success"><%= notice %></div>
<% } %>

<div class="table-wrap">
  <% if (!users.length) { %>
    <div class="empty">
      <p>No users found yet.</p>
      <a class="btn btn-primary" href="/user/new">Create the first user</a>
    </div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Username</th>
          <th>Email</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (let user of users) { %>
          <tr>
            <td class="mono"><%= user.id %></td>
            <td><%= user.username %></td>
            <td><%= user.email %></td>
            <td>
              <div class="row-actions">
                <a class="btn btn-secondary btn-sm" href="/user/<%= user.id %>/edit">Edit</a>
                <form method="POST" action="/user/<%= user.id %>?_method=DELETE" onsubmit="return confirm('Delete this user permanently?');">
                  <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include("partials/footer") %>
